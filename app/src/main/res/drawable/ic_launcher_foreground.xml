<?xml version="1.0" encoding="utf-8"?>
<!--
  VaneGlider adaptive icon foreground: upright symmetrical swept glider wing
  with two overhead concentric rounded signal arcs. Drawn inside the 66dp safe
  zone of the 108dp adaptive icon canvas so no part is clipped by any mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full wing silhouette in white behind the shaded right facet so
         subpixel antialiasing never creates a dark hairline down the center. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,40.5 L71,78 L54,71.5 L37,78 Z" />

    <!-- Right wing facet in warm cream (primaryContainerLight). -->
    <path
        android:fillColor="#FFE7C2"
        android:pathData="M54,40.5 L71,78 L54,71.5 Z" />

    <!-- Inner overhead signal arc (center 54,42.5; radius 9.2; +/-50 deg). -->
    <path
        android:fillColor="#00000000"
        android:pathData="M46.95,36.59 A9.2,9.2 0 0,1 61.05,36.59"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.6" />

    <!-- Outer overhead signal arc (center 54,42.5; radius 16.0; +/-50 deg). -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41.74,32.22 A16,16 0 0,1 66.26,32.22"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.6" />
</vector>
