---
import type { Locale, TranslationSchema } from '@/i18n/types';
import VaneGliderLogo from './icons/VaneGliderLogo.astro';
import UiIcons from './icons/UiIcons.astro';

interface Props {
  d: TranslationSchema;
  locale: Locale;
}

const { d } = Astro.props;

const REPO = 'https://github.com/smurfiez/VaneGlider';
const projectLinks = [
  { label: d.footer.links.github, href: REPO },
  { label: d.footer.links.releases, href: `${REPO}/releases` },
  { label: d.footer.links.changelog, href: `${REPO}/blob/main/CHANGELOG.md` },
  { label: d.footer.links.contributing, href: `${REPO}/blob/main/CONTRIBUTING.md` },
  { label: d.footer.links.issues, href: `${REPO}/issues` },
];

const credits = [
  { label: 'Kite', href: 'https://github.com/itsHenry35/Kite' },
  { label: 'doubletake', href: 'https://github.com/omarroth/doubletake' },
  { label: 'UxPlay', href: 'https://github.com/FDH2/UxPlay' },
  { label: 'pyatv', href: 'https://github.com/postlund/pyatv' },
  { label: 'shairport-sync', href: 'https://github.com/mikebrady/shairport-sync' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-outline-variant bg-surface-low">
  <div class="mx-auto max-w-[1120px] px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2">
          <VaneGliderLogo size={28} />
          <span class="text-[15px] font-semibold tracking-[-0.01em]">VaneGlider</span>
        </div>
        <p class="mt-3 max-w-[26rem] text-[13px] leading-[1.5] text-on-surface-variant">{d.footer.tagline}</p>
        <p class="mt-3 text-[12px] text-outline">
          <a
            href="https://www.gnu.org/licenses/lgpl-3.0.html"
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:text-on-bg">GNU LGPL-3.0</a>
        </p>
      </div>

      <nav aria-label={d.footer.projectHeading}>
        <h3 class="text-[11px] font-medium uppercase tracking-[0.11em] text-outline">{d.footer.projectHeading}</h3>
        <ul class="mt-3">
          {
            projectLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[32px] items-center gap-1.5 text-[14px] text-on-surface-variant hover:text-on-bg"
                >
                  {link.label}
                  <UiIcons name="external" size={13} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="text-[11px] font-medium uppercase tracking-[0.11em] text-outline">{d.footer.languagesHeading}</h3>
        <p class="mt-3 text-[13px] leading-[1.5] text-on-surface-variant">{d.footer.languagesList}</p>

        <h3 class="mt-6 text-[11px] font-medium uppercase tracking-[0.11em] text-outline">{d.footer.creditsHeading}</h3>
        <p class="mt-3 text-[12px] leading-[1.5] text-on-surface-variant">{d.footer.creditsNote}</p>
        <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
          {
            credits.map((credit) => (
              <li>
                <a
                  href={credit.href}
                  rel="noopener noreferrer"
                  class="text-[12px] text-on-surface-variant underline underline-offset-2 hover:text-on-bg"
                >
                  {credit.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-[12px] text-outline">{d.footer.licensesLine}</p>
      </div>
    </div>

    <div class="mt-10 border-t border-outline-variant pt-6 text-[12px] text-outline">
      © {year} VaneGlider · GNU LGPL-3.0
    </div>
  </div>
</footer>
