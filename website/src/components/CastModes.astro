---
import type { TranslationSchema } from '@/i18n/types';
import UiIcons from '@/components/icons/UiIcons.astro';

interface Props {
  d: TranslationSchema;
}

const { d } = Astro.props;
const { castModes } = d;

// handoff §6.2: screen-only leaves phone audio alone; the other two mute it.
const phoneIcon = (id: string) => (id === 'video' ? 'volume' : 'mute');
const receiverIcon = (id: string) => (id === 'audio' ? 'speaker' : 'monitor');
---

<section class="py-14 sm:py-20">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6 lg:px-8" data-castmode>
    <header>
      <p class="text-[11px] font-medium uppercase tracking-[0.11em] text-outline">{castModes.eyebrow}</p>
      <h2
        class="mt-3 max-w-[42rem] text-[clamp(1.625rem,2.5vw,2.25rem)] font-semibold leading-[1.18] tracking-[-0.02em]"
      >
        {castModes.heading}
      </h2>
      <p class="mt-3 max-w-[44rem] text-[16px] leading-[1.55] text-on-surface-variant">{castModes.subtitle}</p>
    </header>

    <div role="tablist" aria-label={castModes.eyebrow} class="mt-8 flex flex-wrap gap-2">
      {
        castModes.tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`castmode-tab-${tab.id}`}
            aria-controls={`castmode-panel-${tab.id}`}
            aria-selected={i === 0}
            tabindex={i === 0 ? 0 : -1}
            data-selected={i === 0 ? 'true' : undefined}
            class="min-h-[44px] rounded-full border border-outline-variant bg-surface-low px-4 text-[14px] font-medium text-on-surface-variant transition-colors data-[selected=true]:border-transparent data-[selected=true]:bg-primary-container data-[selected=true]:text-on-primary-container"
          >
            {tab.title}
          </button>
        ))
      }
    </div>

    <div class="mt-6">
      {
        castModes.tabs.map((tab, i) => (
          <div
            role="tabpanel"
            id={`castmode-panel-${tab.id}`}
            aria-labelledby={`castmode-tab-${tab.id}`}
            tabindex="0"
            hidden={i !== 0}
            class="grid gap-6 rounded-[20px] border border-outline-variant bg-surface-low p-6 md:grid-cols-2"
          >
            <div>
              <h3 class="text-[19px] font-semibold">{tab.title}</h3>
              <p class="mt-2 text-[14px] leading-[1.5] text-on-surface-variant">{tab.summary}</p>
              <p class="mt-4 text-[14px]">{tab.bestFor}</p>
              <span class="mt-3 inline-flex items-center rounded-full bg-surface-high px-3 py-1 text-[12px] text-on-surface-variant">
                {tab.triggerHint}
              </span>
            </div>

            <div class="rounded-[14px] bg-surface-container p-4 self-start">
              <div class="flex items-center gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-surface-high text-on-surface-variant">
                  <UiIcons name={phoneIcon(tab.id)} size={20} />
                </span>
                <span class="inline-flex min-w-0 items-center rounded-full bg-surface-low px-3 py-1 text-[12px] text-on-surface-variant">
                  {tab.phoneAudioBadge}
                </span>
              </div>

              <div class="my-3 flex items-center gap-2 pl-4" aria-hidden="true">
                <span class="vg-tally-rail" data-state="active"></span>
                <span class="h-px flex-1 bg-outline-variant"></span>
              </div>

              <div class="flex items-center gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-surface-high text-on-surface-variant">
                  <UiIcons name={receiverIcon(tab.id)} size={20} />
                </span>
                <span class="min-w-0 text-[13px] font-medium">{tab.title}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* `hidden` must beat the panel's `grid` utility. */
  [role='tabpanel'][hidden] {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-castmode]').forEach((root) => {
    const tablist = root.querySelector('[role="tablist"]');
    const tabs = Array.from(tablist?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (!tabs.length || tabs.length !== panels.length) return;

    function activate(index: number) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected) tab.setAttribute('data-selected', 'true');
        else tab.removeAttribute('data-selected');
        panels[i].hidden = !selected;
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (event) => {
        let next = -1;
        if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        event.preventDefault();
        activate(next);
        tabs[next].focus();
      });
    });
  });
</script>
