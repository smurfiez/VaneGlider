---
import type { TranslationSchema } from '@/i18n/types';
import type { ReleaseInfo } from '@/lib/release';
import VaneGliderLogo from './icons/VaneGliderLogo.astro';
import UiIcons from './icons/UiIcons.astro';

interface Props {
  d: TranslationSchema;
  release: ReleaseInfo;
}

const { d, release } = Astro.props;
const sizeNote = !release.isFallback && release.apkSizeMb ? ` · ${release.apkSizeMb}` : '';
---

<section class="py-14 sm:py-20" aria-labelledby="download-heading">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[20px] bg-primary-container p-6 text-on-primary-container sm:p-10">
      <div class="absolute right-8 top-8 hidden opacity-90 sm:block">
        <VaneGliderLogo size={48} />
      </div>

      <p class="text-[11px] font-medium uppercase tracking-[0.11em] text-[color:var(--vg-on-primary-container-muted)]">
        {d.download.eyebrow}
      </p>
      <h2
        id="download-heading"
        class="mt-2 max-w-[34rem] text-[1.375rem] font-semibold leading-[1.2] sm:text-[clamp(1.625rem,2.5vw,2.25rem)]"
      >
        {d.download.heading}
      </h2>
      <p class="mt-3 max-w-[38rem] text-[15px] leading-[1.55] text-[color:var(--vg-on-primary-container-muted)]">
        {d.download.body}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3 sm:gap-5">
        <a
          href={release.apkUrl}
          class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-primary px-6 font-medium text-on-primary transition-colors hover:bg-[color:var(--vg-primary-hover)]"
        >
          <UiIcons name="download" size={18} />
          {d.download.primaryCta} v{release.version}{sizeNote}
        </a>
        <a
          href={release.releasePageUrl}
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center gap-1.5 text-[14px] underline underline-offset-4"
        >
          {d.download.allReleases}
          <UiIcons name="external" size={14} />
        </a>
      </div>

      <div class="mt-8 max-w-[38rem] rounded-[14px] border border-[color:var(--md-outline-variant)] bg-[color:var(--md-surface-lowest)]/60 p-4">
        <p class="text-[14px] font-medium">{d.download.kiteTitle}</p>
        <p class="mt-1 text-[13px] leading-[1.5] opacity-90">{d.download.kiteBody}</p>
      </div>

      <div class="mt-6">
        <p class="text-[14px] font-medium">{d.download.whatsNewTitle}</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            d.download.whatsNewItems.map((item) => (
              <li class="flex items-start gap-2 text-[13px] leading-[1.5] opacity-90">
                <UiIcons name="check" size={15} class="mt-0.5 shrink-0" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
