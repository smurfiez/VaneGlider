---
import type { TranslationSchema } from '@/i18n/types';
import UiIcons from './icons/UiIcons.astro';

interface Props {
  d: TranslationSchema;
}

const { d } = Astro.props;
---

<section id="features" class="py-14 sm:py-20">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6 lg:px-8">
    <p class="text-[11px] uppercase tracking-[0.14em] text-outline">{d.benefits.eyebrow}</p>
    <h2
      class="mt-3 max-w-[42rem] text-[clamp(1.625rem,2.5vw,2.25rem)] font-semibold leading-[1.18] tracking-[-0.02em]"
    >
      {d.benefits.heading}
    </h2>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        d.benefits.items.map((item, i) => (
          <article class="vg-card-interactive rounded-[20px] border border-outline-variant bg-surface-low p-6">
            <span
              class:list={[
                'flex h-11 w-11 items-center justify-center rounded-[14px]',
                i === 0
                  ? 'bg-primary-container text-on-primary-container'
                  : 'bg-surface-highest text-on-surface-variant',
              ]}
            >
              <UiIcons name={item.icon} size={20} />
            </span>
            <h3 class="mt-4 text-[19px] font-semibold leading-[1.32] tracking-[-0.01em]">
              {item.title}
            </h3>
            <p class="mt-2 text-[14px] leading-[1.5] text-on-surface-variant">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
