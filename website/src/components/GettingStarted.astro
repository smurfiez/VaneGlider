---
import type { TranslationSchema } from '@/i18n/types';
import UiIcons from '@/components/icons/UiIcons.astro';

interface Props {
  d: TranslationSchema;
}

const { d } = Astro.props;
const { gettingStarted } = d;
---

<section id="how-it-works" class="py-14 sm:py-20">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6 lg:px-8">
    <header>
      <p class="text-[11px] font-medium uppercase tracking-[0.11em] text-outline">{gettingStarted.eyebrow}</p>
      <h2
        class="mt-3 max-w-[42rem] text-[clamp(1.625rem,2.5vw,2.25rem)] font-semibold leading-[1.18] tracking-[-0.02em]"
      >
        {gettingStarted.heading}
      </h2>
    </header>

    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      {
        gettingStarted.steps.map((step) => (
          <li>
            <article class="h-full rounded-[20px] border border-outline-variant bg-surface-low p-6">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-primary-container text-[14px] font-semibold text-on-primary-container">
                {step.step}
              </span>
              <h3 class="mt-4 text-[16px] font-medium">{step.title}</h3>
              <p class="mt-2 text-[14px] leading-[1.5] text-on-surface-variant">{step.body}</p>
            </article>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 rounded-[20px] border border-outline-variant bg-surface-high p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <span
          class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-tertiary-container text-on-tertiary-container"
        >
          <UiIcons name="shield" size={22} />
        </span>
        <div class="min-w-0">
          <h3 class="text-[19px] font-semibold">{gettingStarted.permissionsTitle}</h3>
          <p class="mt-1 text-[14px] leading-[1.5] text-on-surface-variant">{gettingStarted.permissionsSubtitle}</p>
        </div>
      </div>

      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          gettingStarted.permissions.map((permission, i) => (
            <li
              class:list={[
                'rounded-[14px] bg-surface-low p-4',
                // The microphone row is the one the copy must make unmistakable.
                i === 0 && 'border border-[color:var(--md-tertiary)]',
              ]}
            >
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-[14px] font-medium">{permission.name}</span>
                <span class="rounded-full bg-tertiary-container px-2 py-0.5 text-[11px] text-on-tertiary-container">
                  {permission.scope}
                </span>
              </div>
              <p class="mt-1.5 text-[13px] leading-[1.5] text-on-surface-variant">{permission.reason}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
